FROM apache/airflow:2.10.5-python3.11

RUN pip install --no-cache-dir \
    pandas \
    numpy \
    scipy \
    minio \
    evidently \
    prometheus-client \
    requests \
    scikit-learn \
    xgboost \
    mlflow \
    joblib \
    feast \
    pyarrow \
    apache-airflow-providers-cncf-kubernetes

RUN pip install --no-cache-dir --upgrade pyOpenSSL cryptography