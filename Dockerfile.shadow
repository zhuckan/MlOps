FROM python:3.9-slim AS downloader

WORKDIR /app

RUN pip install --no-cache-dir mlflow scikit-learn xgboost joblib boto3

COPY download_model_for_shadow.py .

ARG MLFLOW_TRACKING_URI=http://host.docker.internal:5001
ENV MLFLOW_TRACKING_URI=${MLFLOW_TRACKING_URI}

RUN python download_model_for_shadow.py

FROM python:3.9-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --from=downloader /app/model.pkl .
COPY app.py .

EXPOSE 8000

ENTRYPOINT ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]